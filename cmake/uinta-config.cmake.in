@PACKAGE_INIT@

list(PREPEND CMAKE_MODULE_PATH "${CMAKE_CURRENT_LIST_DIR}/modules")

# Re-run the same find-then-FetchContent modules engine-lib's own build uses,
# so the targets referenced by uinta-targets.cmake
include(abseil-cpp)
include(GLFW)
include(glm)
include(yaml-cpp)
include(stb)
include(manifold)

include("${CMAKE_CURRENT_LIST_DIR}/uinta-targets.cmake")

check_required_components(uinta)
